# نسخة المرجع من متغيّرات Supabase — انسخها إلى .env.local واملأ القيم.
# على GitHub: Settings ← Secrets and variables ← Actions ← New repository secret
# بنفس الاسمين (يحقنهما خطوة البناء في .github/workflows/deploy.yml).
#
# ⚠ المفتاح السري (sb_secret_…) لا يُكتب هنا ولا في أي مكان في الموقع —
#   هو للخادم فقط، والمتصفح يحتاج المفتاح القابل للنشر (sb_publishable_…) وحده.
VITE_SUPABASE_URL=https://YOUR-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
